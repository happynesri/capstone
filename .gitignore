# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments and local config
.venv/
venv/
env/
.env
.env.*

# Source data and generated datasets
/data_1/
/raw_data/
/datasets/

# Generated inspection/training outputs
output_stone/

# Skip all images under result/ (recursive)
/result/**/*.png
/result/**/*.jpg
/result/**/*.jpeg
/result/**/*.bmp
/result/**/*.webp

# Skip root-level result json snapshots
/result/*.json

# Model weights and exported artifacts
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.weights

# ROS2 workspace build outputs
/ros2_ws/
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/

# Local Copilot/editor metadata
/.codex

# Large/generated arrays and reports
*.npy
*.npz

# OS/editor noise
.DS_Store
Thumbs.db
